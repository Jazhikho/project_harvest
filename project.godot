;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Project Harvest"
config/description="A survival horror game set in a shifting corn maze where failed runs become part of future attempts."
config/version="0.1a"
run/main_scene="uid://bsj660auwdaqv"
config/features=PackedStringArray("4.4", "Forward Plus")
boot_splash/image="uid://bfcs07l4fo4rs"
config/icon="res://icon.svg"

[autoload]

AudioManager="*res://scripts/autoloads/system/AudioManager.gd"
SaveManager="*res://scripts/autoloads/system/SaveManager.gd"
SceneManager="*res://scripts/autoloads/system/SceneManager.gd"
InputManager="*res://scripts/autoloads/system/InputManager.gd"
SettingsManager="*res://scripts/autoloads/system/SettingsManager.gd"
MessageBus="*res://scripts/autoloads/system/MessageBus.gd"
PlayerInventory="*res://scripts/systems/PlayerInventory.gd"

[debug]

gdscript/warnings/unused_variable=0
gdscript/warnings/unused_parameter=0
gdscript/warnings/unused_signal=0
gdscript/warnings/narrowing_conversion=0

[dotnet]

project/assembly_name="Project Harvest"

[global_group]

player="player group"

