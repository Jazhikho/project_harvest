; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Project Harvest *DEMO VERSION*"
config/description="A survival horror game set in a shifting corn maze where failed runs become part of future attempts."
config/version="0.1a"
run/main_scene="uid://bsj660auwdaqv"
config/features=PackedStringArray("4.4", "Forward Plus")
boot_splash/image="uid://bfcs07l4fo4rs"
config/icon="uid://c86qjupnoisob"

[autoload]

MessageBus="*res://scripts/autoloads/gameloop/MessageBus.gd"
HarvestLogger="*res://scripts/autoloads/gameloop/HarvestLogger.gd"
SaveManager="*res://scripts/autoloads/system/SaveManager.gd"
AudioManager="*res://scripts/autoloads/system/AudioManager.gd"
SettingsManager="*res://scripts/autoloads/system/SettingsManager.gd"
SceneManager="*res://scripts/autoloads/system/SceneManager.gd"
InputManager="*res://scripts/autoloads/system/InputManager.gd"
GameStateManager="*res://scripts/autoloads/gameloop/GameStateManager.gd"
EventManager="*res://scripts/autoloads/gameloop/EventManager.gd"
ItemManager="*res://scripts/autoloads/gameloop/ItemManager.tscn"
SanityManager="*res://scripts/autoloads/gameloop/SanityManager.gd"
PlayerInventory="*res://scripts/systems/PlayerInventory.gd"
TileStateManager="*res://scripts/autoloads/gameloop/TileStateManager.gd"
MazeManager="*res://scripts/autoloads/gameloop/MazeManager.gd"
EnemyManager="*res://scripts/autoloads/gameloop/EnemyManager.tscn"
EffigyManager="*res://scripts/autoloads/gameloop/EffigyManager.gd"
SpawnManager="*res://scripts/autoloads/gameloop/SpawnManager.gd"
TileManager="*res://scripts/autoloads/gameloop/TileManager.gd"
DeathHandler="*res://scripts/autoloads/gameloop/DeathHandler.gd"
GameDirector="*res://scripts/autoloads/gameloop/GameDirector.gd"

[debug]

gdscript/warnings/unused_variable=0
gdscript/warnings/unused_parameter=0
gdscript/warnings/unused_signal=0
gdscript/warnings/narrowing_conversion=0

[display]

window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale=1.0
window/stretch/scale_mode="integer"

[dotnet]

project/assembly_name="Project Harvest"

