## Event Bus Pattern

### MessageBus Architecture
Implement a centralized `MessageBus` autoload for decoupled communication.

**Key Features:**
1. **Type-safe signal definitions**: Define all signals explicitly
2. **Circular reference protection**: Prevent infinite loops
3. **Event history logging**: Debug event flow
4. **Safe emission wrapper**: Validate before emitting

**Implementation:**

```gdscript
extends Node
## Central communication hub for application-wide events

# === LIFECYCLE EVENTS ===
signal app_started()
signal app_paused(paused: bool)
signal app_exiting()

# === UI EVENTS ===
signal menu_opened(menu_name: String)
signal menu_closed(menu_name: String)
signal notification_requested(message: String, duration: float, priority: int)

# === DATA EVENTS ===
signal data_loaded(data_type: String, data: Dictionary)
signal data_saved(data_type: String, success: bool)

# === SETTINGS EVENTS ===
signal setting_changed(category: String, key: String, old_value: Variant, new_value: Variant)

var _event_history: Array[Dictionary] = []
var _max_history: int = 100
var _emission_stack: Array[String] = []
var _max_stack_depth: int = 10

func emit_event(signal_name: String, args: Array = []) -> bool:
    """
    Safely emit a signal with circular reference protection
    
    @param signal_name: Signal to emit
    @param args: Arguments (max 5)
    @return: True if emitted successfully
    """
    if not has_signal(signal_name):
        push_error("MessageBus: Unknown signal '%s'" % signal_name)
        return false
    
    if args.size() > 5:
        push_error("MessageBus: Too many args for '%s' (max 5)" % signal_name)
        return false
    
    # Circular reference check
    if _is_circular_emission(signal_name):
        push_warning("MessageBus: Circular emission detected for '%s'" % signal_name)
        return false
    
    _emission_stack.append(signal_name)
    _log_event(signal_name, args)
    
    # Emit with correct arg count
    match args.size():
        0: emit_signal(signal_name)
        1: emit_signal(signal_name, args[0])
        2: emit_signal(signal_name, args[0], args[1])
        3: emit_signal(signal_name, args[0], args[1], args[2])
        4: emit_signal(signal_name, args[0], args[1], args[2], args[3])
        5: emit_signal(signal_name, args[0], args[1], args[2], args[3], args[4])
    
    _emission_stack.pop_back()
    return true

func _is_circular_emission(signal_name: String) -> bool:
    if _emission_stack.size() >= _max_stack_depth:
        return true
    return signal_name in _emission_stack

func connect_event(signal_name: String, callable: Callable, flags: int = 0) -> int:
    """Safely connect to a signal"""
    if not has_signal(signal_name):
        push_error("MessageBus: Cannot connect to unknown signal '%s'" % signal_name)
        return ERR_DOES_NOT_EXIST
    
    if is_connected(signal_name, callable):
        push_warning("MessageBus: Already connected to '%s'" % signal_name)
        return ERR_ALREADY_EXISTS
    
    return connect(signal_name, callable, flags)

func _log_event(signal_name: String, args: Array) -> void:
    var event := {
        "signal": signal_name,
        "args": args.duplicate(),
        "timestamp": Time.get_ticks_msec(),
        "stack_depth": _emission_stack.size()
    }
    
    _event_history.append(event)
    if _event_history.size() > _max_history:
        _event_history.pop_front()
```

### Event Naming Conventions
- **Past tense for completed actions**: `data_loaded`, `menu_closed`, `setting_changed`
- **Present tense for requests**: `notification_requested`, `audio_fade_requested`
- **Categorize events by domain**: Prefix with domain (e.g., `ui_*`, `data_*`, `audio_*`)

