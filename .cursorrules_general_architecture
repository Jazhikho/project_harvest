## Manager/Autoload System

### BaseManager Pattern
Create a `BaseManager` class that all manager autoloads extend. This centralizes:
- System path constants
- Deferred initialization
- Event connection helpers
- Common logging utilities
- Validation of required dependencies

**Structure:**

```gdscript
extends Node
class_name BaseManager

# Core system references
var _message_bus: Node
var _state_manager: Node
var _save_manager: Node

# Initialization state
var _is_initialized: bool = false
var _required_systems: Array[String] = []

# System paths dictionary
const SYSTEM_PATHS = {
    "MessageBus": "/root/MessageBus",
    "SaveManager": "/root/SaveManager",
    "SettingsManager": "/root/SettingsManager",
    # ... add your systems here
}

func _ready() -> void:
    add_to_group("managers")
    call_deferred("_base_initialize")

func _base_initialize() -> void:
    if _is_initialized:
        return
    
    # Get core references
    _message_bus = get_system_node("MessageBus")
    _save_manager = get_system_node("SaveManager")
    
    # Validate required systems
    if not _validate_required_systems():
        push_error("%s: Required systems not available" % get_manager_name())
        return
    
    # Call derived class initialization
    _initialize_manager()
    _connect_base_events()
    _is_initialized = true

func _initialize_manager() -> void:
    """Override in derived classes"""
    pass

func get_system_node(system_name: String) -> Node:
    """Safe system access with error handling"""
    if not SYSTEM_PATHS.has(system_name):
        push_warning("%s: Unknown system '%s'" % [get_manager_name(), system_name])
        return null
    
    var node = get_node_or_null(SYSTEM_PATHS[system_name])
    if not node:
        push_warning("%s: System '%s' not found" % [get_manager_name(), system_name])
    return node

func require_systems(systems: Array[String]) -> void:
    """Specify required dependencies"""
    _required_systems = systems

func _validate_required_systems() -> bool:
    for system_name in _required_systems:
        if not get_system_node(system_name):
            push_error("%s: Required system '%s' missing" % [get_manager_name(), system_name])
            return false
    return true

func get_manager_name() -> String:
    return name if name else get_script().get_path().get_file().get_basename()

func emit_event(event_name: String, args: Array = []) -> void:
    """Emit event through MessageBus with validation"""
    if not _message_bus:
        push_warning("%s: Cannot emit event - MessageBus unavailable" % get_manager_name())
        return
    _message_bus.emit_event(event_name, args)

func log_error(message: String) -> void:
    push_error("%s: %s" % [get_manager_name(), message])

func log_warning(message: String) -> void:
    push_warning("%s: %s" % [get_manager_name(), message])
```

### Manager Categories

**System Managers** (infrastructure):
- `MessageBus`: Event communication hub
- `SaveManager`: Persistence layer
- `SettingsManager`: Configuration management
- `SceneManager`: Scene transitions
- `AudioManager`: Sound and music playback

**Application Managers** (domain-specific):
- Extend from your domain logic (e.g., `GameStateManager`, `InventoryManager`)
- Always extend `BaseManager` if using the pattern
- Keep focused on single responsibility

