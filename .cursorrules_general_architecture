## Save System Architecture

### SaveManager Pattern

**Key responsibilities:**
- Save/load game state to persistent storage
- Handle save file versioning and migration
- Validate save data integrity
- Emit events on save/load operations

**Structure:**

```gdscript
extends Node

const SAVE_PATH = "user://save_data.sav"
const SAVE_VERSION = "1.0"

signal save_completed(success: bool)
signal load_completed(success: bool)

var save_data: Dictionary = {}

func _ready() -> void:
    _initialize_save_structure()
    load_game()

func _initialize_save_structure() -> void:
    """Define default save structure"""
    save_data = {
        "version": SAVE_VERSION,
        "timestamp": 0,
        "player_data": {},
        "progress": {},
        "settings": {},
        "statistics": {}
    }

func save_game() -> bool:
    """Save game state to disk"""
    save_data.timestamp = Time.get_unix_time_from_system()
    
    var file = FileAccess.open(SAVE_PATH, FileAccess.WRITE)
    if not file:
        push_error("SaveManager: Failed to open save file for writing")
        emit_signal("save_completed", false)
        return false
    
    file.store_var(save_data)
    file.close()
    
    emit_signal("save_completed", true)
    return true

func load_game() -> bool:
    """Load game state from disk"""
    if not has_save_data():
        return false
    
    var file = FileAccess.open(SAVE_PATH, FileAccess.READ)
    if not file:
        push_error("SaveManager: Failed to open save file for reading")
        emit_signal("load_completed", false)
        return false
    
    save_data = file.get_var()
    file.close()
    
    # Migrate old save formats
    _migrate_save_data()
    
    emit_signal("load_completed", true)
    return true

func has_save_data() -> bool:
    return FileAccess.file_exists(SAVE_PATH)

func delete_save() -> void:
    """Delete save file and reset data"""
    if has_save_data():
        DirAccess.remove_absolute(SAVE_PATH)
    _initialize_save_structure()

func _migrate_save_data() -> void:
    """Handle save file version migration"""
    var loaded_version = save_data.get("version", "0.0")
    
    if loaded_version != SAVE_VERSION:
        push_warning("SaveManager: Migrating save from v%s to v%s" % [loaded_version, SAVE_VERSION])
        
        # Add missing keys from new structure
        var default_structure = {}
        _initialize_save_structure()
        _merge_dictionaries(save_data, default_structure)
        
        # Update version
        save_data.version = SAVE_VERSION
        save_game()

func _merge_dictionaries(target: Dictionary, source: Dictionary) -> void:
    """Recursively merge source into target, preserving target values"""
    for key in source:
        if not target.has(key):
            target[key] = source[key]
        elif typeof(source[key]) == TYPE_DICTIONARY and typeof(target[key]) == TYPE_DICTIONARY:
            _merge_dictionaries(target[key], source[key])

# Public API
func set_value(category: String, key: String, value: Variant) -> void:
    if not save_data.has(category):
        save_data[category] = {}
    save_data[category][key] = value

func get_value(category: String, key: String, default: Variant = null) -> Variant:
    if not save_data.has(category):
        return default
    return save_data[category].get(key, default)
```

### Auto-Save Pattern

```gdscript
var _autosave_timer: Timer

func _ready() -> void:
    _setup_autosave()

func _setup_autosave() -> void:
    _autosave_timer = Timer.new()
    _autosave_timer.wait_time = 60.0  # Save every 60 seconds
    _autosave_timer.autostart = true
    _autosave_timer.timeout.connect(_on_autosave_timer_timeout)
    add_child(_autosave_timer)

func _on_autosave_timer_timeout() -> void:
    if _should_autosave():
        save_game()

func _should_autosave() -> bool:
    # Only autosave during gameplay, not in menus
    var tree = get_tree()
    return tree and not tree.paused
```

