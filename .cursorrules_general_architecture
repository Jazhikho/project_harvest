## UI System Architecture

### UI Component Principles

1. **Process Mode**: Set to `PROCESS_MODE_ALWAYS` (3) for pause menus
2. **Dark Overlay Pattern**: Use semi-transparent ColorRect for modal backgrounds
3. **Panel Centering**: Use anchor presets for responsive layouts
4. **Signal-Based Communication**: Never call methods directly on parent scenes
5. **Separation of Concerns**: UI only displays and emits signals; logic lives in managers

### Standard UI Component Structure

```gdscript
extends Control
## UI Component Description

# Signals for communication with parent/controller
signal opened()
signal closed()
signal action_requested(action_name: String, data: Dictionary)

# Node references (use @onready)
@onready var main_panel = $MainPanel
@onready var close_button = $MainPanel/CloseButton

# State
var _is_open: bool = false

func _ready() -> void:
    # Connect internal signals
    if close_button:
        close_button.pressed.connect(_on_close_pressed)
    
    # Initialize state
    hide()
    _setup_ui()

func _setup_ui() -> void:
    """Initialize UI elements - override in derived classes"""
    pass

func open_ui() -> void:
    """Open with animation"""
    show()
    _is_open = true
    _animate_open()
    emit_signal("opened")

func close_ui() -> void:
    """Close with animation"""
    _animate_close()
    await _get_animation_tween().finished
    hide()
    _is_open = false
    emit_signal("closed")

func _animate_open() -> void:
    """Animate panel opening"""
    var tween: Tween = create_tween()
    main_panel.modulate.a = 0.0
    main_panel.scale = Vector2(0.8, 0.8)
    tween.tween_property(main_panel, "modulate:a", 1.0, 0.2)
    tween.parallel().tween_property(main_panel, "scale", Vector2.ONE, 0.3).set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_BACK)

func _animate_close() -> void:
    var tween: Tween = create_tween()
    tween.tween_property(main_panel, "modulate:a", 0.0, 0.15)
    tween.parallel().tween_property(main_panel, "scale", Vector2(0.8, 0.8), 0.15)

func _on_close_pressed() -> void:
    close_ui()
```

### Common UI Components

#### Pause Menu Pattern

```gdscript
extends Control

signal resume_requested()
signal settings_requested()
signal main_menu_requested()
signal quit_requested()

@onready var menu_panel = $MenuPanel
@onready var settings_panel = $SettingsPanel

