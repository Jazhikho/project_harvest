## Data Management

### Data-Driven Design
- **Separate data from logic**: Store configuration in JSON or `.tres` Resource files
- **JSON for structured data**: Item definitions, narrative text, object interactions
- **Resources for editor-configurable data**: Catalogs, databases, settings

### JSON Data Pattern

```gdscript
const DATA_PATH := "res://data/items.json"

var _data_cache: Dictionary = {}

func load_data() -> void:
    """Load and parse JSON data"""
    if not FileAccess.file_exists(DATA_PATH):
        push_error("Data file not found: %s" % DATA_PATH)
        return
    
    var file = FileAccess.open(DATA_PATH, FileAccess.READ)
    if not file:
        push_error("Failed to open data file: %s" % DATA_PATH)
        return
    
    var json = JSON.new()
    var parse_result = json.parse(file.get_as_text())
    file.close()
    
    if parse_result != OK:
        push_error("Failed to parse JSON: %s at line %d" % [json.get_error_message(), json.get_error_line()])
        return
    
    _data_cache = json.data
    _validate_data()

func _validate_data() -> void:
    """Validate loaded data structure"""
    if not _data_cache.has("version"):
        push_warning("Data file missing version field")
    
    if not _data_cache.has("items"):
        push_error("Data file missing required 'items' field")

func get_data(key: String) -> Variant:
    """Safe data access"""
    if not _data_cache.has(key):
        push_warning("Data key not found: %s" % key)
        return null
    return _data_cache[key]
```

