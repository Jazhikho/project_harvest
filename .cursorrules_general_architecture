## Scene Management

### SceneManager Pattern

**Responsibilities:**
- Handle scene transitions
- Manage scene preloading
- Provide transition effects (fades, etc.)
- Track scene history for back navigation

```gdscript
extends Node

const SCENES = {
    "main_menu": "res://scenes/ui/MainMenu.tscn",
    "game": "res://scenes/game/Game.tscn",
    "settings": "res://scenes/ui/Settings.tscn",
    "credits": "res://scenes/ui/Credits.tscn"
}

var _scene_history: Array[String] = []
var _current_scene: String = ""
var _transition_layer: CanvasLayer

func _ready() -> void:
    _setup_transition_layer()

func _setup_transition_layer() -> void:
    """Create overlay for fade transitions"""
    _transition_layer = CanvasLayer.new()
    _transition_layer.layer = 100
    add_child(_transition_layer)
    
    var fade_rect = ColorRect.new()
    fade_rect.name = "FadeRect"
    fade_rect.color = Color.BLACK
    fade_rect.modulate.a = 0.0
    fade_rect.set_anchors_preset(Control.PRESET_FULL_RECT)
    _transition_layer.add_child(fade_rect)

func change_scene(scene_key: String, fade_duration: float = 0.5) -> void:
    """Change scene with fade transition"""
    if not SCENES.has(scene_key):
        push_error("SceneManager: Unknown scene key '%s'" % scene_key)
        return
    
    await _fade_out(fade_duration / 2.0)
    
    _scene_history.append(_current_scene)
    _current_scene = scene_key
    
    get_tree().change_scene_to_file(SCENES[scene_key])
    
    await get_tree().process_frame
    await _fade_in(fade_duration / 2.0)

func go_back(fade_duration: float = 0.5) -> void:
    """Return to previous scene"""
    if _scene_history.is_empty():
        push_warning("SceneManager: No scene history to go back to")
        return
    
    var previous_scene = _scene_history.pop_back()
    await change_scene(previous_scene, fade_duration)

func reload_current_scene(fade_duration: float = 0.5) -> void:
    """Reload the current scene"""
    await change_scene(_current_scene, fade_duration)

func _fade_out(duration: float) -> void:
    var fade_rect = _transition_layer.get_node("FadeRect")
    var tween = create_tween()
    tween.tween_property(fade_rect, "modulate:a", 1.0, duration)
    await tween.finished

func _fade_in(duration: float) -> void:
    var fade_rect = _transition_layer.get_node("FadeRect")
    var tween = create_tween()
    tween.tween_property(fade_rect, "modulate:a", 0.0, duration)
    await tween.finished
```

